# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin gate ---
# Only this email is allowed to reach /admin. Must match the Supabase Auth user.
ADMIN_EMAIL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Guard with requireAdmin() in application code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (see STRIPE_SETUP.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Resend (email notifications to ADMIN_EMAIL) ---
RESEND_API_KEY=
# The verified sending address in Resend. E.g. audit@yourdomain.com
RESEND_FROM_EMAIL=
